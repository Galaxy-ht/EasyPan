# ==========================================
# EasyPan Demo 配置
# ==========================================

# 应用服务 WEB 访问端口
server.port=7090
server.servlet.context-path=/api
#session过期时间 60M 一个小时
server.servlet.session.timeout=PT60M
#处理favicon
spring.mvc.favicon.enable=false

#异常处理
spring.mvc.throw-exception-if-no-handler-found=true
spring.web.resources.add-mappings=false

# H2 嵌入式数据库 (MySQL 兼容模式)
spring.datasource.url=jdbc:h2:file:./data/easypan;MODE=MySQL;DATABASE_TO_LOWER=TRUE;CASE_INSENSITIVE_IDENTIFIERS=TRUE;DB_CLOSE_DELAY=-1
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=
# H2 控制台（生产环境请设为 false）
spring.h2.console.enabled=false
spring.h2.console.path=/h2-console

# 启动时执行 schema.sql 建表
spring.sql.init.mode=always
spring.sql.init.schema-locations=classpath:schema.sql

mybatis-plus.type-aliases-package=com.easypan.entity.po
mybatis-plus.mapper-location=classpath:com/easypan/mappers/*.xml
mybatis-plus.configuration.log-impl=org.apache.ibatis.logging.stdout.StdOutImpl

# 发送邮件配置（注册验证码）
spring.mail.host=smtp.qq.com
spring.mail.port=465
spring.mail.username=1258695019@qq.com
spring.mail.password=bokctqmltzdjhhid
spring.mail.default-encoding=UTF-8
spring.mail.properties.mail.smtp.socketFactory.class=javax.net.ssl.SSLSocketFactory
spring.mail.properties.mail.debug=true

# 文件上传限制
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# 项目目录
project.folder=./storage

# 日志
log.root.level=info

# 管理员邮箱（逗号分隔）
admin.emails=admin@test.com

# storage_bak 备份路径（每次初始化时从此路径覆盖 storage）
mirror.storage.bak.path=./storage_bak

# Demo 模式配置
demo.mode=true
demo.admin.email=admin@test.com
demo.admin.password=123456
demo.user.init.space=50
demo.new.user.space=5

# 安全：隐藏错误信息
server.error.include-message=never
server.error.include-stacktrace=never